@model List<MyHRExample.Services.ResumeItemModel>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <title>HR Analytics</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <style>
            body { background: linear-gradient(135deg, #fff0f5 0%, #fce4ec 50%, #f8bbd0 100%); min-height: 100vh; font-family: 'Segoe UI', sans-serif; }
            .analytics-container { max-width: 1200px; margin: 0 auto; padding: 40px 15px; }
            .stat-card { background: rgba(255, 255, 255, 0.95); border-radius: 16px; padding: 20px; text-align: center; box-shadow: 0 10px 25px rgba(216, 27, 96, 0.08); border-bottom: 4px solid #d81b60; }
            .chart-wrapper { background: rgba(255, 255, 255, 0.95); border-radius: 16px; padding: 20px; box-shadow: 0 10px 25px rgba(216, 27, 96, 0.08); margin-bottom: 30px; }
            .table-wrapper { background: rgba(255, 255, 255, 0.95); border-radius: 16px; padding: 30px; box-shadow: 0 10px 25px rgba(216, 27, 96, 0.08); }
            .custom-solid-btn { background: linear-gradient(135deg, #d81b60 0%, #ad1457 100%); color: white; border: none; border-radius: 12px; padding: 8px 16px; text-decoration: none; }
            .custom-outline-btn { background-color: rgba(255, 255, 255, 0.7); color: #d81b60; border: 2px solid #d81b60; border-radius: 12px; padding: 8px 16px; text-decoration: none; transition: all 0.3s ease; }
        .custom-outline-btn:hover { background-color: #d81b60; color: white; text-decoration: none; }
    </style>
</head>
<body>

    <div class="container pt-4 mb-4 text-center">
        <a asp-action="Index" class="btn custom-outline-btn me-2 fw-semibold">Вакансія</a>
        <a asp-action="Candidate" class="btn custom-outline-btn me-2 fw-semibold">Кандидат</a>
        <a asp-action="HrResumes" class="btn custom-outline-btn me-2 fw-semibold">HR Dashboard</a>
        <a asp-action="HrAnalytics" class="btn custom-solid-btn fw-semibold">📈 Аналітика</a>
    </div>

    <div class="analytics-container">
        <h2 class="fw-bold text-center mb-5" style="color: #880e4f;">📈 Аналітика кандидатів</h2>

        <div class="row mb-5">
            <div class="col-md-6">
                <div class="chart-wrapper">
                    <h5 class="text-center fw-bold mb-3" style="color: #880e4f;">Статус кандидатів</h5>
                    <div style="position: relative; height: 250px; width: 100%;">
                        <canvas id="statusChart"></canvas>
                    </div>
                </div>
            </div>
            <div class="col-md-6">
                <div class="chart-wrapper">
                    <h5 class="text-center fw-bold mb-3" style="color: #880e4f;">Найбільш затребувані навички</h5>
                    <div style="position: relative; height: 250px; width: 100%;">
                        <canvas id="skillsChart"></canvas>
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-5">
            <div class="col-md-6">
                <div class="chart-wrapper">
                    <h5 class="text-center fw-bold" style="color: #880e4f;">Статус кандидатів</h5>
                    <canvas id="statusChart" height="200"></canvas>
                </div>
            </div>
            <div class="col-md-6">
                <div class="chart-wrapper">
                    <h5 class="text-center fw-bold" style="color: #880e4f;">Найбільш затребувані навички</h5>
                    <canvas id="skillsChart" height="200"></canvas>
                </div>
            </div>
        </div>

        <div class="table-wrapper">
            <h4 class="fw-bold mb-4" style="color: #880e4f;">Топ проаналізованих кандидатів</h4>
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr style="color: #880e4f;">
                            <th>Кандидат</th>
                            <th>Кількість навичок</th>
                            <th>Підтверджені вимоги</th>
                            <th>Деталі</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="fw-bold">@item.CandidateName</td>
                                <td>@(item.Analysis.Skills?.Count ?? 0)</td>
                                <td><span class="badge bg-success">@(item.Analysis.ConfirmedRequirements?.Count ?? 0) збігів</span></td>
                                <td><a asp-action="ViewAnalysis" asp-route-resumeKey="@item.Key" class="btn btn-sm btn-outline-danger rounded-pill px-3">Звіт</a></td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
            new Chart(document.getElementById('statusChart'), {
                type: 'doughnut',
                data: {
                    labels: ['Проаналізовано', 'Очікують'],
                    datasets: [{
                        data: [@ViewBag.AnalyzedCount, @ViewBag.PendingCount],
                        backgroundColor: ['#d81b60', '#ffcc80'],
                        borderWidth: 0
                    }]
                },
                options: { responsive: true, maintainAspectRatio: false }
            });

            new Chart(document.getElementById('skillsChart'), {
                type: 'bar',
                data: {
                    labels: @Html.Raw(ViewBag.SkillsLabels ?? "[]"),
                    datasets: [{
                        label: 'Кількість кандидатів',
                        data: @Html.Raw(ViewBag.SkillsData ?? "[]"),
                        backgroundColor: '#f8bbd0',
                        borderColor: '#d81b60',
                        borderWidth: 1,
                        borderRadius: 5
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
                }
            });
    </script>
</body>
</html>