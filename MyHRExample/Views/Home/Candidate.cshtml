@model MyHRExample.Models.CandidateModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <title>Сторінка кандидата — Подача резюме</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
            body {
                background: linear-gradient(135deg, #fff0f5 0%, #fce4ec 50%, #f8bbd0 100%);
                min-height: 100vh;
                font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            }

            .form-wrapper {
                background: rgba(255, 255, 255, 0.9);
                backdrop-filter: blur(12px);
                border: 1px solid rgba(255, 182, 193, 0.6);
                border-radius: 24px;
                padding: 40px;
                box-shadow: 0 15px 35px rgba(216, 27, 96, 0.1);
            }

            .custom-btn {
                background: linear-gradient(135deg, #d81b60 0%, #ad1457 100%);
                color: white;
                border: none;
                border-radius: 12px;
                transition: all 0.3s ease;
            }

                .custom-btn:hover {
                    background: linear-gradient(135deg, #ad1457 0%, #880e4f 100%);
                    color: white;
                    transform: translateY(-2px);
                }

            .custom-outline-btn {
                background-color: rgba(255, 255, 255, 0.7);
                color: #d81b60;
                border: 2px solid #d81b60;
                border-radius: 12px;
                padding: 8px 16px;
                transition: all 0.3s ease;
            }

                .custom-outline-btn:hover {
                    background-color: #d81b60;
                    color: white;
                    border-color: #d81b60;
                }

            .custom-solid-btn {
                background: linear-gradient(135deg, #d81b60 0%, #ad1457 100%);
                color: white;
                border: none;
                border-radius: 12px;
                padding: 10px 20px;
                box-shadow: 0 4px 10px rgba(216, 27, 96, 0.3);
                transition: all 0.3s ease;
            }

                .custom-solid-btn:hover {
                    background: linear-gradient(135deg, #ad1457 0%, #880e4f 100%);
                    color: white;
                    transform: translateY(-2px);
                    box-shadow: 0 6px 15px rgba(216, 27, 96, 0.4);
                }
    </style>
</head>
<body>

    <div class="container pt-4 mb-4 text-center">
        <a asp-action="Index" class="btn custom-outline-btn me-2 fw-semibold">Вакансія</a>
        <a asp-action="Candidate" class="btn custom-outline-btn me-2 fw-semibold">Кандидат</a>
        <a asp-action="HrResumes" class="btn custom-outline-btn me-2 fw-semibold">HR Dashboard</a>
        <a asp-action="HrAnalytics" class="btn custom-outline-btn fw-semibold">📈 Аналітика</a>
    </div>

    <div class="container d-flex justify-content-center align-items-center" style="min-height: 85vh;">
        <div class="form-wrapper w-100" style="max-width: 600px;">
            <div class="text-center mb-4">
                <h2 class="fw-bold" style="color: #880e4f;">Подача резюме</h2>
                <p class="text-muted small">Заповніть свої дані та завантажте PDF-файл</p>
            </div>

            @if (TempData["SuccessMessage"] != null)
            {
                <div class="alert alert-success text-center rounded-3">@TempData["SuccessMessage"]</div>
            }

            <form asp-action="Candidate" method="post" enctype="multipart/form-data">
                <div class="mb-3">
                    <label class="form-label fw-semibold" style="color: #880e4f;">ПІБ кандидата</label>
                    <input asp-for="FullName" class="form-control form-control-lg rounded-3" placeholder="напр. Іван Петренко" required />
                </div>

                <div class="mb-3">
                    <label class="form-label fw-semibold" style="color: #880e4f;">Контактні дані</label>
                    <input asp-for="Contacts" class="form-control form-control-lg rounded-3" placeholder="напр. email@example.com / +380..." required />
                </div>

                <div class="mb-4">
                    <label class="form-label fw-semibold" style="color: #880e4f;">Резюме (формат PDF)</label>
                    <input asp-for="ResumeFile" type="file" class="form-control form-control-lg rounded-3" accept=".pdf" required />
                    <span asp-validation-for="ResumeFile" class="text-danger small"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn custom-btn btn-lg py-3 fw-bold">Відправити резюме</button>
                </div>
            </form>
        </div>
    </div>

</body>
</html>