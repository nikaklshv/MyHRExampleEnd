@model List<MyHRExample.Services.ResumeItemModel>
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <title>HR Dashboard</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
            body {
                background: linear-gradient(135deg, #fff0f5 0%, #fce4ec 50%, #f8bbd0 100%);
                min-height: 100vh;
                font-family: 'Segoe UI', Tahoma, sans-serif;
            }

            .dashboard-container {
                max-width: 1200px;
                margin: 0 auto;
                padding: 40px 15px;
            }

            .candidate-card {
                background: rgba(255, 255, 255, 0.95);
                border-radius: 16px;
                border-left: 6px solid #d81b60;
                box-shadow: 0 10px 25px rgba(216, 27, 96, 0.08);
                transition: transform 0.2s;
                margin-bottom: 20px;
            }

                .candidate-card:hover {
                    transform: translateY(-3px);
                }

            .badge-skill {
                background-color: #fce4ec;
                color: #d81b60;
                border: 1px solid #f8bbd0;
                font-weight: 500;
            }

            .custom-solid-btn {
                background: linear-gradient(135deg, #d81b60 0%, #ad1457 100%);
                color: white;
                border: none;
                border-radius: 12px;
                padding: 8px 16px;
                box-shadow: 0 4px 10px rgba(216, 27, 96, 0.3);
                transition: all 0.3s ease;
                text-decoration: none;
            }

                .custom-solid-btn:hover {
                    background: linear-gradient(135deg, #ad1457 0%, #880e4f 100%);
                    color: white;
                    transform: translateY(-2px);
                }

            .custom-outline-btn {
            background-color: rgba(255, 255, 255, 0.7);
            color: #d81b60;
            border: 2px solid #d81b60;
            border-radius: 12px;
            padding: 8px 16px;
            text-decoration: none;
            transition: all 0.3s ease;
        }
        .custom-outline-btn:hover {
            background-color: #d81b60;
            color: white;
            text-decoration: none;
        }
            
    </style>
</head>
<body>

    <div class="container pt-4 mb-4 text-center">
        <a asp-action="Index" class="btn custom-outline-btn me-2 fw-semibold">Вакансія</a>
        <a asp-action="Candidate" class="btn custom-outline-btn me-2 fw-semibold">Кандидат</a>
        <a asp-action="HrResumes" class="btn custom-outline-btn me-2 fw-semibold">HR Dashboard</a>
        <a asp-action="HrAnalytics" class="btn custom-outline-btn fw-semibold">📈 Аналітика</a>
    </div>

    <div class="dashboard-container">
        <h2 class="fw-bold text-center mb-5" style="color: #880e4f;">📊 Панель управління кандидатами</h2>

        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success text-center rounded-3">@TempData["SuccessMessage"]</div>
        }

        @if (Model == null || !Model.Any())
        {
            <div class="alert alert-light text-center rounded-3">Резюме ще не надходили.</div>
        }
        else
        {
            @foreach (var candidate in Model)
            {
                <div class="candidate-card p-4">
                    <div class="row align-items-center">
                        <!-- Основна інфо -->
                        <div class="col-md-3">
                            <h4 class="fw-bold text-dark mb-1">@candidate.CandidateName</h4>
                            <p class="text-muted small mb-2">📄 @candidate.FileName</p>
                            @if (candidate.IsAnalyzed)
                            {
                                <span class="badge bg-success bg-opacity-25 text-success border border-success fw-bold px-3 py-2 rounded-pill">✅ Проаналізовано</span>
                            }
                            else
                            {
                                <span class="badge bg-warning bg-opacity-25 text-warning border border-warning fw-bold px-3 py-2 rounded-pill">⏳ Очікує аналізу</span>
                            }
                        </div>

                        <!-- Результати аналізу -->
                        <div class="col-md-7">
                            @if (candidate.IsAnalyzed && candidate.Analysis != null)
                            {
                                <div class="mb-2">
                                    <strong>🛠 Навички:</strong>
                                    @if (candidate.Analysis.Skills != null)
                                    {
                                        foreach (var skill in candidate.Analysis.Skills.Take(4))
                                        {
                                            <span class="badge badge-skill me-1">@skill</span>
                                        }
                                    }
                                </div>
                                <p class="mb-0 text-muted small"><strong>AI Summary:</strong> @candidate.Analysis.Summary</p>
                            }
                            else
                            {
                                <p class="text-muted fst-italic mb-0">Система ще обробляє це резюме. Натисніть "Зробити аналіз", щоб запустити вручну.</p>
                            }
                        </div>

                        <!-- Кнопки дій -->
                        <div class="col-md-2 text-end d-flex flex-column gap-2 mt-3 mt-md-0">
                            @if (candidate.IsAnalyzed)
                            {
                                <a asp-action="ViewAnalysis" asp-route-resumeKey="@candidate.Key" class="btn custom-solid-btn fw-bold w-100 text-center">Деталі</a>
                            }
                            else
                            {
                                <form asp-action="AnalyzeResume" method="post" class="w-100">
                                    <input type="hidden" name="resumeKey" value="@candidate.Key" />
                                    <button type="submit" class="btn custom-solid-btn fw-bold w-100">✨ Аналіз</button>
                                </form>
                            }
                            
                            <a asp-action="DownloadResume" asp-route-key="@candidate.Key" class="btn btn-outline-secondary btn-sm w-100 fw-semibold" target="_blank">Відкрити PDF</a>
                            
                            <form asp-action="DeleteResume" method="post" class="w-100" onsubmit="return confirm('Ви впевнені, що хочете видалити це резюме та результати його аналізу?');">
                                <input type="hidden" name="key" value="@candidate.Key" />
                                <button type="submit" class="btn btn-outline-danger btn-sm fw-bold w-100">Видалити</button>
                            </form>
                        </div>
                    </div>
                </div>
            }
        }
    </div>
</body>
</html>