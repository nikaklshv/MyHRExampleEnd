@model MyHRExample.Models.VacancyModel

@{
    Layout = null;
    string successMessage = TempData["SuccessMessage"] as string;
}

<!DOCTYPE html>
<html lang="uk">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>HR Панель — Створення вакансії</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
            .custom-outline-btn {
                background-color: rgba(255, 255, 255, 0.7);
                color: #d81b60;
                border: 2px solid #d81b60;
                border-radius: 12px;
                padding: 8px 16px;
                transition: all 0.3s ease;
            }

                .custom-outline-btn:hover {
                    background-color: #d81b60;
                    color: white;
                    border-color: #d81b60;
                }

            .custom-solid-btn {
                background: linear-gradient(135deg, #d81b60 0%, #ad1457 100%);
                color: white;
                border: none;
                border-radius: 12px;
                padding: 10px 20px;
                box-shadow: 0 4px 10px rgba(216, 27, 96, 0.3);
                transition: all 0.3s ease;
            }

                .custom-solid-btn:hover {
                    background: linear-gradient(135deg, #ad1457 0%, #880e4f 100%);
                    color: white;
                    transform: translateY(-2px);
                    box-shadow: 0 6px 15px rgba(216, 27, 96, 0.4);
                }
    </style>
</head>
<body>

    <div class="container pt-4 mb-4 text-center">
        <a asp-action="Index" class="btn custom-outline-btn me-2 fw-semibold">Вакансія</a>
        <a asp-action="Candidate" class="btn custom-outline-btn me-2 fw-semibold">Кандидат</a>
        <a asp-action="HrResumes" class="btn custom-outline-btn me-2 fw-semibold">HR Dashboard</a>
        <a asp-action="HrAnalytics" class="btn custom-outline-btn fw-semibold">📈 Аналітика</a>
    </div>

    <div class="hr-page-container">
        <div class="form-wrapper">

            <div class="text-center mb-4">
                <h1 class="fw-bold title-text">Створення вакансії</h1>
                <p class="subtitle-text">Введіть вимоги до кандидата для публікації</p>
            </div>

            @if (!string.IsNullOrEmpty(successMessage))
            {
                <div class="alert custom-alert mb-4 text-center py-3" role="alert">
                    @successMessage
                </div>
            }

            <form asp-action="UploadText" method="post">
                <div class="mb-3">
                    <label asp-for="Title" class="form-label fw-semibold">Назва вакансії</label>
                    <input asp-for="Title" class="form-control form-control-lg custom-input" placeholder="напр. .NET Senior Developer" required />
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="Department" class="form-label fw-semibold">Відділ</label>
                        <input asp-for="Department" class="form-control form-control-lg custom-input" placeholder="напр. Engineering" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="SalaryRange" class="form-label fw-semibold">Зарплатна вилка</label>
                        <input asp-for="SalaryRange" class="form-control form-control-lg custom-input" placeholder="напр. $2000 - $3500" />
                    </div>
                </div>

                <div class="mb-4">
                    <label asp-for="Requirements" class="form-label fw-semibold">Вимоги до кандидата</label>
                    <textarea name="requirementText" class="form-control" rows="5" placeholder="Введіть вимоги тут..." required></textarea>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn custom-solid-btn w-100 py-2 fw-bold fs-5 mt-3">Зберегти та відправити в S3</button>
                    </button>
                </div>
            </form>

        </div>
    </div>

</body>
</html>

<style>
    html, body {
        height: 100%;
        margin: 0;
        background: linear-gradient(135deg, #fff0f5 0%, #fce4ec 50%, #f8bbd0 100%);
        font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    }

    .hr-page-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
        padding: 20px;
    }

    .form-wrapper {
        background: rgba(255, 255, 255, 0.85);
        backdrop-filter: blur(12px);
        border: 1px solid rgba(255, 182, 193, 0.6);
        border-radius: 24px;
        padding: 40px;
        width: 100%;
        max-width: 700px;
        box-shadow: 0 15px 35px rgba(216, 27, 96, 0.1);
    }

    .title-text {
        color: #880e4f;
        font-size: 2.2rem;
    }

    .subtitle-text {
        color: #ad1457;
        font-size: 0.95rem;
    }

    .form-label {
        color: #880e4f;
    }

    .custom-input {
        background-color: rgba(255, 255, 255, 0.95);
        border: 1px solid #f8bbd0;
        border-radius: 12px;
        transition: all 0.3s ease;
    }

        .custom-input:focus {
            background-color: #ffffff;
            border-color: #d81b60;
            box-shadow: 0 0 0 0.25rem rgba(216, 27, 96, 0.15);
        }

    .custom-btn {
        background: linear-gradient(135deg, #d81b60 0%, #ad1457 100%);
        color: white;
        border: none;
        border-radius: 12px;
        transition: all 0.3s ease;
    }

        .custom-btn:hover {
            background: linear-gradient(135deg, #ad1457 0%, #880e4f 100%);
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(216, 27, 96, 0.25);
            color: white;
        }

    .custom-alert {
        background-color: #f8bbd0;
        border: none;
        color: #880e4f;
        border-radius: 12px;
        font-weight: 500;
    }
</style>